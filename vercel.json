{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(api|auth)/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "17 8 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "git": {
    "deploymentEnabled": {
      "app-sdr": false,
      "colores": false
    }
  }
}
