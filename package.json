{
  "name": "orderbrain-sdr",
  "version": "2.0.0",
  "description": "Prospección de colegios para el equipo de ventas de OrderEAT, conectada a Pipedrive",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.mjs",
