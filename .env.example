# --- Pipedrive ---
# Token de API de un usuario administrador (Pipedrive > Configuración personal > API)
PIPEDRIVE_API_TOKEN=
# Subdominio de la empresa en Pipedrive (ordereat.pipedrive.com -> ordereat)
PIPEDRIVE_DOMAIN=ordereat

# --- Claude (asistente, briefs de llamada, mensajes y ordenado de notas) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Login con Google ---
# Client ID de OAuth (Google Cloud > APIs y servicios > Credenciales > ID de cliente web)
GOOGLE_CLIENT_ID=
# Solo pueden entrar cuentas de este dominio
ALLOWED_EMAIL_DOMAIN=ordereat.com

# --- Sesión ---
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# --- Equipo ---
# Meta diaria de contactos por SDR
DAILY_GOAL=40
# Carpeta para el cruce con Pipedrive y el registro de contactos (usar un disco persistente en producción)
# DATA_DIR=/data

# --- Opcional: Redis de Upstash (en Vercel: Storage > Upstash for Redis, se cargan solas) ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Opcional: pisar embudos y etapas de entrada por país (JSON) ---
# SALES_PIPELINES={"México":[9,160],"Perú":[29,258],"Argentina":[1,112],"Chile":[2,14],"Uruguay":[3,108]}

# --- Solo para desarrollo local ---
# Entra sin Google con este email
# DEV_LOGIN_EMAIL=tu-email@ordereat.com
# Pipedrive de prueba en memoria (solo si no hay PIPEDRIVE_API_TOKEN)
# DEMO_MODE=1

PORT=3000

# OrderBrain general (World Dominion): marca como cliente, para no contactarlo, a todo colegio que ya es sitio de OrderEAT.
# Token Bearer de brain.ordereat.com (idealmente uno de servicio, de solo lectura, que no venza).
# Opcional: un líder lo puede pegar en Equipo → World Dominion (queda en Redis y manda sobre este).
BRAIN_TOKEN=
# BRAIN_URL=https://brain.ordereat.com
